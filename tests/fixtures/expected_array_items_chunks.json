  {
    "chunk_id": "2af7be13d548763ba8603cdf3a5ba004385ae5276b04ad8c0c3171d29efaa7d6",
    "content": {
      "type": "object",
      "description": "Backup configuration for the volume including schedule, retention, and destination.\nBackups are performed using volume snapshots and stored according to the specified\npolicy. Critical for disaster recovery and data protection strategies.\n",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable automated backups for this volume",
          "default": false
        },
        "schedule": {
          "type": "string",
          "description": "Cron expression defining backup schedule. Examples: \"0 2 * * *\" (daily at 2 AM),\n\"0 */6 * * *\" (every 6 hours). Uses standard cron syntax with minute, hour,\nday of month, month, and day of week fields.\n",
          "pattern": "^(\\*|[0-9,\\-/]+)\\s+(\\*|[0-9,\\-/]+)\\s+(\\*|[0-9,\\-/]+)\\s+(\\*|[0-9,\\-/]+)\\s+(\\*|[0-9,\\-/]+)$"
        },
        "retention": {
          "type": "integer",
          "description": "Number of backup snapshots to retain. Older snapshots beyond this count are\nautomatically deleted. Minimum value of 1 ensures at least one backup is always\navailable. Typical values range from 7 (daily backups for a week) to 30+ for\nmonthly retention.\n",
          "minimum": 1,
          "default": 7
        }
      }
    },
