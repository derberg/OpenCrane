    "content": {
      "type": "string",
      "description": "Storage capacity specification using Kubernetes resource notation. Supports\nunits: Ki (kibibytes), Mi (mebibytes), Gi (gibibytes), Ti (tebibytes),\nPi (pebibytes). Examples: \"10Gi\", \"500Mi\", \"1Ti\". The specified size is the\nminimum guaranteed capacity; actual provisioned size may be larger depending\non storage class and provisioner configuration.\n",
      "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi)$"
    },
