    "content": {
      "type": "string",
      "description": "Volume access mode defining how the volume can be mounted by pods. ReadWriteOnce\nallows mounting by a single node with read-write access. ReadOnlyMany allows\nmounting by multiple nodes with read-only access. ReadWriteMany allows mounting\nby multiple nodes with read-write access. Choice depends on storage backend\ncapabilities and application requirements.\n",
      "enum": [
        "ReadWriteOnce",
        "ReadOnlyMany",
        "ReadWriteMany"
      ]
    },
